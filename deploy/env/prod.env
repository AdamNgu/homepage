# Non-sensitive, environment-specific config for homepage (PROD).
# Installed by install-app.sh to ~deploy/.config/homepage/app.env and loaded
# via podman --env-file (values are verbatim after the first '=': no quotes,
# spaces allowed). Change via PR, apply with install-app.sh + restart.
# Secrets NEVER go here — see fetch-secrets.sh and CONFIG-AND-SECRETS.md.
HOME_LAT=40.6936
HOME_LON=-73.9902
HOME_LABEL=Brooklyn, NY 11201
WEATHER_USER_AGENT=(homepage, adamtnguyen@icloud.com)

# Worked example from CONFIG-AND-SECRETS.md — uncomment when the app consumes
# it (its secret counterpart INFOSEC_API_SECRET comes from CyberArk):
# INFOSEC_API_URL=https://infosec-api.corp.example.com
