[Unit]
Description=Homepage app
Requires=redis.service
After=redis.service

[Container]
# Loaded into local storage by the deploy job (registry-less artifact flow).
Image=localhost/homepage:latest
ContainerName=homepage
Network=homepage.network
# Loopback-only: host NGINX is the front door.
PublishPort=127.0.0.1:3000:3000
# Topology (not environment) stays inline:
Environment=REDIS_URL=redis://redis:6379
# Non-sensitive per-environment config, installed by install-app.sh <env>:
EnvironmentFile=%h/.config/homepage/app.env
# Secrets fetched from CyberArk by ExecStartPre at every start (empty file
# when dormant — it must always exist; quadlet has no optional prefix):
EnvironmentFile=%t/homepage/secrets.env
HealthCmd=node backend/dist/healthcheck.js
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s
# systemd counts the start as successful only once the health check passes,
# so `systemctl --user restart` fails on a broken image (deploy job catches it).
Notify=healthy
HealthOnFailure=kill

[Service]
RuntimeDirectory=homepage
ExecStartPre=%h/.local/bin/homepage-fetch-secrets %t/homepage/secrets.env
Restart=always

[Install]
WantedBy=default.target
