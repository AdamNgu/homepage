# Non-sensitive, environment-specific config for homepage (DEV).
# Same variables as prod.env — only values may differ between environments.
# Installed by install-app.sh to ~deploy/.config/homepage/app.env and loaded
# via podman --env-file (values are verbatim after the first '=': no quotes,
# spaces allowed). Secrets NEVER go here — see fetch-secrets.sh.
HOME_LAT=40.6936
HOME_LON=-73.9902
HOME_LABEL=Brooklyn, NY 11201 (dev)
WEATHER_USER_AGENT=(homepage-dev, adamtnguyen@icloud.com)

# Worked example from CONFIG-AND-SECRETS.md:
# INFOSEC_API_URL=https://infosec-api.dev.corp.example.com
